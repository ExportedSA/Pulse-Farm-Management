# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pulse_db

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-secret-key-here

# Hardware Module Configuration
# Set to "1" for demo/training mode (simulator), "0" for real hardware
PULSE_SIM_MODE=1

# URL of the Python gateway (only needed if PULSE_SIM_MODE=0)
PULSE_GATEWAY_URL=http://localhost:8000

# Optional: require this token to toggle demo mode via API
# Leave empty to allow all users to toggle demo mode
PULSE_DEMO_ADMIN_TOKEN=

# File storage: a private S3-compatible bucket (AWS S3 or Cloudflare R2). See docs/hosting.md.
# Leave S3_BUCKET_NAME unset in development: files are then kept in ./uploads (or UPLOADS_DIR).
# S3_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=ap-southeast-2            # AWS S3 only
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # Cloudflare R2 only

# Email (Mailtrap). See docs/hosting.md.
# With no token, development writes emails to the server log instead of sending them.
# With a token and a sandbox id, emails are caught in that Mailtrap sandbox and never delivered.
# With a token and no sandbox id, emails are really sent (needs a verified sending domain).
# MAILTRAP_API_TOKEN=your-mailtrap-api-token
# MAILTRAP_SANDBOX_ID=1234567
# EMAIL_FROM=pulse@your-domain.example

# Sentry Error Tracking
# Get DSN from your Sentry project settings
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Logging Configuration
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Redis Configuration (for WebSocket scaling)
# Format: redis://user:password@host:port/db
REDIS_URL=redis://localhost:6379/0
# Or use individual variables:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Instance ID for multi-instance deployments
# If not set, a random UUID will be generated
INSTANCE_ID=

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production origin (if different from above)
PRODUCTION_ORIGIN=https://your-production-domain.com

# Reverse Proxy Configuration
# Set to 'true' if running behind a reverse proxy (nginx, AWS ELB, etc.)
# This enables proper IP forwarding for rate limiting
TRUST_PROXY=false

# Frontend Environment Variables (create client/.env for these)
# VITE_DEMO_ADMIN_TOKEN=your-secret-token

# Farm map satellite imagery (optional). Google: a Google Maps Platform key with the Map Tiles API
# enabled and billing on; restrict it to this site's address (HTTP referrers) and to the Map Tiles API.
# VITE_GOOGLE_MAPS_API_KEY=
# LINZ aerial imagery for New Zealand (free key from basemaps.linz.govt.nz)
# VITE_LINZ_BASEMAPS_KEY=
