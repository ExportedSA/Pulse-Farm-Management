# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pulse_db

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-secret-key-here

# Hardware Module Configuration
# Set to "1" for demo/training mode (simulator), "0" for real hardware
PULSE_SIM_MODE=1

# URL of the Python gateway (only needed if PULSE_SIM_MODE=0)
PULSE_GATEWAY_URL=http://localhost:8000

# Optional: require this token to toggle demo mode via API
# Leave empty to allow all users to toggle demo mode
PULSE_DEMO_ADMIN_TOKEN=

# Frontend Environment Variables (create client/.env for these)
# VITE_DEMO_ADMIN_TOKEN=your-secret-token
