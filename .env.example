# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pulse_db

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-secret-key-here

# Hardware Module Configuration
# Set to "1" for demo/training mode (simulator), "0" for real hardware
PULSE_SIM_MODE=1

# URL of the Python gateway (only needed if PULSE_SIM_MODE=0)
PULSE_GATEWAY_URL=http://localhost:8000

# Optional: require this token to toggle demo mode via API
# Leave empty to allow all users to toggle demo mode
PULSE_DEMO_ADMIN_TOKEN=

# AWS S3 Configuration (for file storage)
# If not set, files will be stored locally in the uploads folder
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Sentry Error Tracking
# Get DSN from your Sentry project settings
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Logging Configuration
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Redis Configuration (for WebSocket scaling)
# Format: redis://user:password@host:port/db
REDIS_URL=redis://localhost:6379/0
# Or use individual variables:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Instance ID for multi-instance deployments
# If not set, a random UUID will be generated
INSTANCE_ID=

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production origin (if different from above)
PRODUCTION_ORIGIN=https://your-production-domain.com

# Reverse Proxy Configuration
# Set to 'true' if running behind a reverse proxy (nginx, AWS ELB, etc.)
# This enables proper IP forwarding for rate limiting
TRUST_PROXY=false

# Frontend Environment Variables (create client/.env for these)
# VITE_DEMO_ADMIN_TOKEN=your-secret-token
