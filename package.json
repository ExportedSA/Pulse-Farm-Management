{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:backend": "vitest --config vitest.config.ts",
    "test:frontend": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:performance": "lhci autorun",
    "test:mobile": "playwright test --project='Mobile Chrome'",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:ci": "npm run test:run && npm run test:coverage && npm run test:e2e",
    "db:test:setup": "NODE_ENV=test npm run db:push",
    "db:test:seed": "NODE_ENV=test npm run db:seed",
    "db:test:reset": "NODE_ENV=test npm run db:drop && npm run db:test:setup"
  },
